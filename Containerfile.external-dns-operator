# Detect the drift from Dockerfile.
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest AS drift
WORKDIR /app
COPY drift-cache/Dockerfile Dockerfile.cached
COPY Dockerfile .
# If the command below fails it means that the Dockerfile from this repository changed.
# You have to update the Konflux Containerfile accordingly.
# drift-cache/Dockerfile can be updated with latest contents once the Konflux version is aligned.
RUN test "$(sha1sum Dockerfile.cached | cut -d' ' -f1)" = "$(sha1sum Dockerfile | cut -d' ' -f1)"


FROM registry.access.redhat.com/ubi9/go-toolset:1.26.10-1794208260 as builder
# dummy copy to trigger the drift detection
COPY --from=drift /app/Dockerfile.cached .
WORKDIR /workspace
# Dummy RUN to create /workspace directory.
# WORKDIR doesn't create the directory (at least for Podman).
# Without this step, the following COPY may create /workspace
# as root-owned (instead of go-toolset's default 1001)
# leading to "Permission denied" errors during "make build-operator"
# when trying to write output.
RUN ls .
COPY . /workspace
# Mark the source dir safe so the commit can be stamped via git in full-clone
# builds (CI, Konflux). Tolerate failure for builds from a git worktree, where
# .git is a gitlink pointing outside the build context and git cannot resolve it.
RUN git config --global --add safe.directory /workspace || true
# Build. GOEXPERIMENT=strictfipsruntime is set here (container build only, on the
# Red Hat go-toolset) so the shipped binary aborts if it cannot operate in FIPS
# mode on a FIPS-enabled host. It is intentionally not in the Makefile: it is a
# go-toolset-only experiment that upstream Go rejects, so `make build` stays
# portable for contributors.
RUN GOEXPERIMENT=strictfipsruntime make build-operator

# Package the manager binary on a distroless static base.
# The binary uses Go's native FIPS 140-3 module (no OpenSSL), so it needs no
# RPMs and can run on a minimal Red Hat Hardened Image static base.
FROM registry.access.redhat.com/hi/static:latest@sha256:c51e17de4a96e3bd68361830ec54f3c43ffcf398b82765a1ce250bd4a0d99d1f
LABEL maintainer="Red Hat, Inc."
LABEL com.redhat.component="external-dns-operator-container"
LABEL name="edo/external-dns-rhel9-operator"
LABEL version="1.3.12"
LABEL cpe="cpe:/a:redhat:ext_dns_optr:1.3::el9"
WORKDIR /
COPY --from=builder /workspace/bin/external-dns-operator /
# Red Hat certified container images have licenses.
COPY LICENSE /licenses/
USER 65532:65532
ENTRYPOINT ["/external-dns-operator"]
